# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. NEVER commit the real file.

YOUTUBE_API_KEY = "paste-your-restricted-youtube-api-key"

# Optional: Google Cloud Storage persistence (separate from YouTube; buckets may incur charges)
# GCS_BUCKET_NAME = "my-private-bucket"
# Either paste the service-account JSON as a TOML table...
# [GCS_SERVICE_ACCOUNT_JSON]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "..."
# token_uri = "https://oauth2.googleapis.com/token"
