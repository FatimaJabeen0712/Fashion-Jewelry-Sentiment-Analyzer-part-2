# Copy to .env and fill in. NEVER commit .env. Leave blank to run in CSV / demo mode.

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# Optional: Google Cloud Storage persistence (separate from YouTube access; may incur charges)
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_JSON=

# Optional, restricted access - only if you own/manage the account or have approval
META_ACCESS_TOKEN=
TIKTOK_RESEARCH_ACCESS_TOKEN=
